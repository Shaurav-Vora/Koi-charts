# Server-only key. Mocked endpoint tests do not need a key.
# Put a real key only in ignored .env.local; restart the server after changes.
ASSEMBLYAI_API_KEY=
# Current app default; optional override for a model enabled on your Gateway account.
ASSEMBLYAI_LLM_MODEL=qwen3.5-4b-32k-fast
# Enable only behind a trusted proxy that overwrites forwarded headers.
TRUST_PROXY=0
