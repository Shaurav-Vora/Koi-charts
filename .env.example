# Server-only keys. Mocked tests do not need real keys.
# Put real keys only in ignored .env.local; restart the server after changes.
# AssemblyAI is used only for speech-to-text.
ASSEMBLYAI_API_KEY=
# Google AI Studio key for direct Gemini command interpretation (not AssemblyAI Gateway).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Enable only behind a trusted proxy that overwrites forwarded headers.
TRUST_PROXY=0
